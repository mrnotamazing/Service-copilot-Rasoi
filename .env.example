# Copy this file to .env and fill in to use Dify for AI assistance.
# Leave empty to use the built-in writer.

# Dify API base: http://localhost/v1 for a local Dify, https://api.dify.ai/v1 for Dify Cloud
DIFY_API_URL=
# The app's API key from Dify (App → API Access → API Key), starts with "app-"
DIFY_API_KEY=

# Optional: require this header value (x-copilot-key) on POS webhooks
COPILOT_INGEST_KEY=
