# Copy this file to .env to switch on AI. With nothing set, the app uses Ollama if it's running
# (free, on this computer), otherwise the built-in trainer.

# Claude (recommended): powers the assistant chat, practice role-plays, guest lines, briefings,
# the private coach and the manager's summary, in each server's language.
# Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional: a different Claude model (default claude-opus-5-5)
ANTHROPIC_MODEL=

# Ollama (free, local): install from ollama.com, run `ollama pull gemma3:4b`, and that's it.
# No key needed. Optional settings:
# OLLAMA_MODEL=gemma3:4b         # which installed model to use (default: the best one installed)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA=off                     # don't use Ollama even if it's running

# Or Dify, if you'd rather manage prompts in a Dify app (used when no Anthropic key is set).
# Dify API base: http://localhost/v1 for a local Dify, https://api.dify.ai/v1 for Dify Cloud
DIFY_API_URL=
# The app's API key from Dify (App → API Access → API Key), starts with "app-"
DIFY_API_KEY=

# Optional: require this header value (x-copilot-key) on POS webhooks
COPILOT_INGEST_KEY=
