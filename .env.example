# Copy this file to .env to switch on AI. The first one set wins: Claude, then Gemini, then Ollama
# if it's running (free, on this computer), then Dify, otherwise the built-in trainer.

# Claude (recommended): powers the assistant chat, practice role-plays, guest lines, briefings,
# the private coach and the manager's summary, in each server's language.
# Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional: a different Claude model (default claude-opus-5-5)
ANTHROPIC_MODEL=

# Google Gemini (free tier, fast on any laptop): get a key at aistudio.google.com → Get API key.
GEMINI_API_KEY=
# Optional: a specific model (default: the newest Gemini Flash your key can use)
# GEMINI_MODEL=gemini-2.5-flash

# Ollama (free, local, works offline; slower on most laptops): install from ollama.com, run `ollama pull gemma3:4b`, and that's it.
# No key needed. Optional settings:
# OLLAMA_MODEL=gemma3:4b         # which installed model to use (default: the best one installed)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA=off                     # don't use Ollama even if it's running

# Or Dify, if you'd rather manage prompts in a Dify app (used when no Anthropic key is set).
# Dify API base: http://localhost/v1 for a local Dify, https://api.dify.ai/v1 for Dify Cloud
DIFY_API_URL=
# The app's API key from Dify (App → API Access → API Key), starts with "app-"
DIFY_API_KEY=

# Optional: require this header value (x-copilot-key) on POS webhooks
COPILOT_INGEST_KEY=

# Natural read-aloud voice (ElevenLabs). The key stays on the server and is never sent to the browser.
# Without it, the app reads aloud with the device's own voice. Get a key at elevenlabs.io.
ELEVENLABS_API_KEY=
# Optional: another voice id from your ElevenLabs library (default: George, a warm storyteller)
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Force the free local model (Ollama) even if a Gemini or Claude key is set above:
# AI_PROVIDER=ollama

# Free, very fast cloud AI (recommended if Ollama is too slow): get a free key at console.groq.com → API Keys.
# Used when no Anthropic or Gemini key is set. Cerebras (CEREBRAS_API_KEY) and OpenRouter (OPENROUTER_API_KEY) work too.
GROQ_API_KEY=
# Optional: pick the model (default llama-3.3-70b-versatile)
# AI_MODEL=llama-3.3-70b-versatile

# OpenRouter free models (openrouter.ai → Keys). To use it instead of Groq, set the key, name the service and the model:
# OPENROUTER_API_KEY=sk-or-...
# AI_CLOUD=openrouter
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Order the models yourself (otherwise they are ordered by job: fast and good for quick answers, strongest for careful ones):
# AI_PRIORITY=openrouter,gemini,groq,ollama
